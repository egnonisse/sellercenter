// SellerCenter Zariamall — schéma de données
// Référence : CONCEPTION.md (v1.1)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== Énumérations =====================

enum Role {
  SUPER_ADMIN // Admin : toutes les validations, tous les droits
  KAM // Key Account Manager : supervision multi-boutiques + actions configurées par l'admin
  SHOP_ADMIN // Vendor : propriétaire de boutique (produits, commandes, finances de SA boutique)
  SHOP_MANAGER // Staff : employé vendeur (produits + commandes, pas les finances)
}

// Permissions par rôle (éditables par l'admin via /admin/roles)
model RolePermission {
  id         String @id @default(cuid())
  role       Role
  permission String // products.manage | products.manage_all | products.qc | ...
  granted    Boolean @default(true)
  createdAt  DateTime @default(now())

  @@unique([role, permission])
}

enum SellerStatus {
  PENDING // inscription reçue, en attente de validation LEO
  ACTIVE
  SUSPENDED
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_QC // en attente de contrôle qualité (LEO)
  ACTIVE
  REJECTED
  DELISTED
  DELETION_PENDING // suppression demandée par le vendeur, en attente de confirmation admin (retention)
}

enum OrderStatus {
  PENDING
  READY_TO_SHIP // prêt à expédier (pattern Jumia)
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SettlementStatus {
  OPEN
  PROCESSING
  PAID
  FAILED
}

enum SyncStatus {
  PENDING
  SYNCED
  ERROR
}

// ===================== Vendeurs & Boutiques =====================

model Seller {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  phone     String
  country   String       @default("CI")
  status    SellerStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  shops     Shop[]
}

model Shop {
  id               String           @id @default(cuid())
  sellerId         String
  seller           Seller           @relation(fields: [sellerId], references: [id])
  name             String
  slug             String           @unique
  logoUrl          String?
  description      String?
  status           ShopStatus       @default(PENDING)
  holidayMode      Boolean          @default(false) // mode vacances (pattern Jumia)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  users            User[]
  products         Product[]
  orders           Order[]
  promotions       Promotion[]
  settlements      Settlement[]
  apiApplications  ApiApplication[]
  importHistory    ImportHistory[]
  notifications    Notification[]
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  role         Role
  shopId       String?              // null pour SUPER_ADMIN
  shop         Shop?                @relation(fields: [shopId], references: [id])
  status       String               @default("ACTIVE") // ACTIVE | INVITED | SUSPENDED
  failedAttempts Int               @default(0) // Échecs de connexion consécutifs (rate limiting login)
  lockoutUntil DateTime?           // Verrouillage temporaire après trop d'échecs
  // Invitation (création d'utilisateur par un admin / un vendeur)
  inviteTokenHash  String?         // SHA-256 du token envoyé par email
  inviteExpiresAt  DateTime?       // expiration du lien d'invitation
  invitedByUserId  String?
  invitedBy        User?           @relation("UserInvitedBy", fields: [invitedByUserId], references: [id])
  invitedUsers     User[]          @relation("UserInvitedBy")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  orderHistory OrderStatusHistory[]
  productHistory ProductHistory[]
  rateHistory CommissionRateHistory[]
  auditLogs    UserAudit[]         @relation("UserAuditTarget")
  auditActions UserAudit[]         @relation("UserAuditActor")
}

// Audit des opérations sur les utilisateurs (qui a créé / changé quel compte)
model UserAudit {
  id           String   @id @default(cuid())
  targetUserId String
  target       User     @relation("UserAuditTarget", fields: [targetUserId], references: [id])
  actorUserId  String?
  actor        User?    @relation("UserAuditActor", fields: [actorUserId], references: [id])
  action       String // CREATED | INVITED | INVITE_RESENT | ROLE_CHANGED | STATUS_CHANGED | PASSWORD_SET
  details      Json? // { before, after }
  createdAt    DateTime @default(now())

  @@index([targetUserId])
}

// ===================== Catalogue =====================

model Category {
  id             String     @id @default(cuid())
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  name           String
  slug           String     @unique
  wooId          Int?       @unique // ID WooCommerce
  commissionRate Float?     // % commission, nullable : hérite du parent, sinon défaut global
  createdAt      DateTime   @default(now())
  products       Product[]
  rateHistory    CommissionRateHistory[]
}

model Product {
  id              String        @id @default(cuid())
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id])
  wooId           Int?          @unique // ID WooCommerce (null si pas encore synchronisé)
  sku             String?       // SKU du vendeur (unique par boutique)
  ean             String?       // EAN / GTIN (code-barres)
  name            String
  slug            String        @unique
  description     String?
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  brand           String?       // nom de marque (texte, pour compatibilité sync/CSV)
  brandId         String?       // référentiel marques (optionnel)
  brandRef        Brand?        @relation(fields: [brandId], references: [id])
  price           Decimal       @db.Decimal(10, 2)
  compareAtPrice  Decimal?      @db.Decimal(10, 2) // ancien prix (affiché barré)
  saleStartDate   DateTime?     // début de la période promo
  saleEndDate     DateTime?     // fin de la période promo
  stockQty        Int           @default(0)
  status          ProductStatus @default(DRAFT)
  qcNote          String?       // commentaire libre du QC
  qcReason        String?       // raison structurée du rejet (REFUSE_REASONS)
  delistReason    String?       // raison du retrait
  delistComment   String?       // commentaire du retrait
  deletionRequestedAt DateTime? // demande de suppression (retention)
  images          Json?         // [{url, position}]
  attributes      Json?         // {color, size, warranty...}
  syncStatus      SyncStatus    @default(PENDING)
  syncError       String?       // message d'erreur de la dernière sync (affiché au vendeur)
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orderItems      OrderItem[]
  promotionProducts PromotionProduct[]
  history         ProductHistory[]

  @@unique([shopId, sku])
  @@index([shopId, status])
}

// ===================== Référentiel marques =====================

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  wooId     Int?      // ID WooCommerce (si connu)
  createdAt DateTime  @default(now())
  products  Product[]
}

// ===================== Historique produit (pattern Jumia) =====================

model ProductHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  action      String   // CREATED | SUBMITTED | APPROVED | REJECTED | UPDATED | DELISTED | DELETION_REQUESTED | DELETED | SYNCED
  from        String?
  to          String?
  note        String?
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  createdAt   DateTime @default(now())

  @@index([productId])
}

// ===================== Historique d'imports CSV (feeds) =====================

model ImportHistory {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  type      String   // CREATION | UPDATE | STOCK | PRICE | STATUS
  fileName  String
  created   Int      @default(0)
  updated   Int      @default(0)
  failed    Int      @default(0)
  errors    Json?    // [{line, error}]
  createdAt DateTime @default(now())

  @@index([shopId])
}

// ===================== Commandes =====================

model Order {
  id            String              @id @default(cuid())
  wooId         Int?                // ID WooCommerce (non unique : une commande WC multi-boutiques = 1 Order par boutique)
  shopId        String
  shop          Shop                @relation(fields: [shopId], references: [id])
  customerName  String
  phone         String
  address       String?
  itemsTotal    Decimal             @db.Decimal(10, 2)
  shippingFee   Decimal             @db.Decimal(10, 2) @default(0)
  total         Decimal             @db.Decimal(10, 2)
  status        OrderStatus         @default(PENDING)
  paymentMethod String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  items         OrderItem[]
  history       OrderStatusHistory[]

  @@index([wooId])
  @@index([shopId, status])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  name           String
  qty            Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  commissionRate Float?   // taux figé au moment de la vente (null = calcul au relevé, rétrocompat)
  settlementLines SettlementLine[]

  @@index([orderId])
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  from        String?
  to          String
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  note        String?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

// ===================== Promotions =====================

model Promotion {
  id        String            @id @default(cuid())
  shopId    String
  shop      Shop              @relation(fields: [shopId], references: [id])
  name      String
  type      String            // PERCENTAGE | FIXED
  value     Decimal           @db.Decimal(10, 2)
  startAt   DateTime
  endAt     DateTime
  status    String            @default("DRAFT") // DRAFT | ACTIVE | ENDED
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  products  PromotionProduct[]
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
}

// ===================== Finances =====================

model Settlement {
  id          String           @id @default(cuid())
  shopId      String
  shop        Shop             @relation(fields: [shopId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  grossSales  Decimal          @db.Decimal(10, 2)
  commission  Decimal          @db.Decimal(10, 2) // calculée par catégorie (commissionRate)
  netPayable  Decimal          @db.Decimal(10, 2)
  status      SettlementStatus @default(OPEN)
  payoutRef   String?          // référence du paiement Mobile Money
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  lines       SettlementLine[]
}

model SettlementLine {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id])
  orderItemId  String
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id])
  gross        Decimal    @db.Decimal(10, 2)
  commission   Decimal    @db.Decimal(10, 2)
  net          Decimal    @db.Decimal(10, 2)

  @@unique([settlementId, orderItemId])
}

// ===================== Notifications =====================

model Notification {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id])
  type      String    // PRODUCT_REJECTED | PRODUCT_APPROVED | ORDER_RECEIVED | SELLER_APPROVED | SETTLEMENT_PAID
  title     String
  message   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([shopId, readAt])
}

// ===================== Infrastructure =====================

model PaymentProvider {
  id        String   @id @default(cuid())
  name      String // WAVE | ORANGE | MTN
  enabled   Boolean  @default(false)
  config    Json?    // {apiKey, secret} — chiffré au stockage
  createdAt DateTime @default(now())
}

model ApiApplication {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id])
  name       String
  tokenHash  String // token API pour intégrations tierces (pattern Jumia)
  scopes     String    @default("products.read,orders.read")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Paramètres globaux (singleton id="global")
model Settings {
  id                   String  @id @default("global")
  defaultCommissionRate Float  @default(10)
  signupOpen           Boolean @default(true)
}

// Historique des taux de commission (audit + validité bi-temporelle simplifiée).
// Une ligne = un taux appliqué sur une période ; la ligne active a validTo = null.
// categoryId null = taux global (Settings.defaultCommissionRate).
model CommissionRateHistory {
  id          String   @id @default(cuid())
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  rate        Float
  validFrom   DateTime
  validTo     DateTime?
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  createdAt   DateTime @default(now())

  @@index([categoryId, validFrom])
}
